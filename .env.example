# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=vision
POSTGRES_USER=vision
POSTGRES_PASSWORD=changeme_strong_password

# ── Security ───────────────────────────────────────────────────────────────────
JWT_SECRET=changeme_use_a_long_random_string_in_production

# ── Email (SMTP or Resend) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@yourdomain.com

# ── App ────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost
OPEN_REGISTRATION=false  # set true to skip invite-only requirement

# ── hCaptcha (free tier) ────────────────────────────────────────────────────────
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# ── AI ─────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...   # optional: Claude fallback if Ollama unavailable

# ── OSINT API Keys (all optional — features degrade gracefully) ────────────────
TINEYE_API_KEY=
GEOSPY_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
HIBP_API_KEY=
GITHUB_TOKEN=
NUMVERIFY_KEY=
